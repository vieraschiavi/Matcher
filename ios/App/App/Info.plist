<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>Matcher</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<!-- Textos que ve la persona cuando iOS le pide el permiso.

	     No son opcionales: sin la clave, la app NO pide el permiso — se cae
	     en el momento de usarlo — y App Store rechaza el envío. Y tienen que
	     decir para qué se usa de verdad: "necesitamos la cámara" sin motivo
	     es causa de rechazo en la revisión. -->
	<!-- La app sólo usa HTTPS estándar: no lleva criptografía propia. Sin
	     esta clave, App Store Connect pregunta por exportación en CADA envío
	     y el build queda trabado esperando respuesta. -->
	<!-- Vuelta del login con Google/Facebook: iOS enruta este esquema a la
	     app. Es el equivalente del intent-filter del AndroidManifest, y sin
	     él Safari muestra "dirección no válida" después de loguearse y la app
	     nunca recibe el token. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.matcher.app.auth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.matcher.app</string>
			</array>
		</dict>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSCameraUsageDescription</key>
	<string>Para sacarte fotos y grabar videos cortos para tu perfil, sin salir de la app.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Para grabar el audio de los videos cortos de tu perfil.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Para que elijas fotos y videos que ya tenés y los subas a tu perfil.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Para guardar en tu carrete las fotos que saques dentro de la app.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Para mostrarte quién hay cerca en el radar y contar con quién te cruzaste. Tu posición se redondea a 500 metros: nadie ve dónde estás exactamente.</string>
</dict>
</plist>
