# Base de la demo: se regenera sola al arrancar el backend.
datos/
*.db

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
venv/
.venv/

# Node / frontend
node_modules/
webapp/frontend/dist/

# Empaquetado de escritorio (Electron). Son cientos de megas de Chromium: el
# instalador se genera en la máquina que publica, no se versiona.
dist-escritorio/

# Capacitor: los proyectos nativos SÍ se commitean.
#
# Estaban ignorados y fue un error: para publicar en Play Store y App Store
# hacen falta cosas que viven ahí y que no se pueden regenerar —
# el versionCode, los permisos del manifest, los íconos y los textos de
# permiso del Info.plist. Regenerándolos en cada build, todo eso se perdía.
# Lo que sí se ignora es la salida de compilación.
android/build/
android/app/build/
android/.gradle/
android/local.properties
android/.idea/
android/app/release/
ios/App/build/
ios/App/Pods/
ios/App/App.xcworkspace/xcuserdata/
ios/App/App.xcodeproj/xcuserdata/
ios/DerivedData/

# Claves de firma. NUNCA en el repo: si se filtra el keystore de publicación,
# no se puede rotar — hay que publicar una app nueva.
*.keystore
*.jks
*.p12
*.mobileprovision
google-services.json
GoogleService-Info.plist

# Sistema
.DS_Store
Thumbs.db

# El kit de marca se genera: `python3 -m marketing.generar_kit`. Se versiona el
# generador, no las 36 imágenes de salida.
marketing/kit/

# Videos generados. Se regeneran con `python3 -m marketing.generar_video` a
# partir de las capturas, que sí se versionan. Las copias que se publican
# viven en landing/media/, que es lo que se sube al hosting.
marketing/video/
